#include<iostream>
using namespace std;
int BinoCoef(int n, int k)
{
   
    int res=1;
    if(k>n-k)
    k=n-k;
   
    for(int i=0;i<k;++i)
    {
       
        res*=(n-i);
        res/=(i+1);
       
    }
    return res;
   
}

void printPascal(int n)
{
   
    for(int l=0;l<n;l++)
    {
       
        for(int m=0;m<=l;m++)
        {
           
            cout<<" "<<BinoCoef(l,m);
           
        }
       
        cout<<endl;
       
    }
}
   
int main()
{
   
    int n = 7;
    printPascal(n);
    return 0;
   
}
