#include <iostream>
using namespace std;

// Class representing a Complex Number using operator overloading
class Complex
{
    float real, imag; // Private members for real and imaginary parts

public:
    // Default constructor: Initializes complex number to 0 + 0i
    Complex()
    {
        real = 0;
        imag = 0;
    }

    // Parameterized constructor: Initializes members with given values
    Complex(float r, float i)
    {
        real = r;
        imag = i;
    }

    // Takes user input for real and imaginary parts
    void accept()
    {
        cout << "Enter real part: ";
        cin >> real;

        cout << "Enter imaginary part: ";
        cin >> imag;
    }

    // Prints complex number in 'a + bi' or 'a - bi' format
    void display()
    {
        cout << real;

        if (imag >= 0)
            cout << " + " << imag << "i";
        else
            cout << " - " << -imag << "i";

        cout << endl;
    }

    // Overloads '+' operator to add two complex objects using syntax: c1 + c2
    Complex operator+(Complex c)
    {
        return Complex(real + c.real, imag + c.imag);
    }

    // Overloads '-' operator for subtraction using syntax: c1 - c2
    Complex operator-(Complex c)
    {
        return Complex(real - c.real, imag - c.imag);
    }

    // Overloads '*' operator for complex multiplication
    Complex operator*(Complex c)
    {
        return Complex(
            real * c.real - imag * c.imag,
            real * c.imag + imag * c.real
        );
    }

    // Overloads '/' operator for complex division using denominator formula
    Complex operator/(Complex c)
    {
        float denominator =
            c.real * c.real + c.imag * c.imag;

        return Complex(
            (real * c.real + imag * c.imag) / denominator,
            (imag * c.real - real * c.imag) / denominator
        );
    }
};

int main()
{
    Complex c1, c2, result; // Calls default constructor for all three

    cout << "Enter first complex number:\n";
    c1.accept();

    cout << "\nEnter second complex number:\n";
    c2.accept();

    // Perform operations using overloaded operators and display results
    result = c1 + c2;
    cout << "\nAddition: ";
    result.display();

    result = c1 - c2;
    cout << "Subtraction: ";
    result.display();

    result = c1 * c2;
    cout << "Multiplication: ";
    result.display();

    result = c1 / c2;
    cout << "Division: ";
    result.display();

    return 0; // end of main function
}
